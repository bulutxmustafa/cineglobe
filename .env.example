# Django
DJANGO_SECRET_KEY=change-me-to-a-secure-random-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production (Vercel), e.g.: https://cineglobe.vercel.app
CSRF_TRUSTED_ORIGINS=
# Proxies in front of Django: 0 locally, 1 on Vercel (client IP from X-Forwarded-For)
TRUSTED_PROXY_COUNT=0

# Database (PostgreSQL)
DATABASE_URL=postgres://cineglobe:cineglobe@localhost:5432/cineglobe
POSTGRES_DB=cineglobe
POSTGRES_USER=cineglobe
POSTGRES_PASSWORD=cineglobe
POSTGRES_PORT=5432

# External APIs
TMDB_API_KEY=

# LLM providers (plan §3.10). Chain is tried left to right; "classic" = no AI, always last.
# Switch to Claude Haiku with: LLM_PROVIDER_CHAIN=anthropic,classic
LLM_PROVIDER_CHAIN=gemini,classic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FREE_TIER=True
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PARSER=claude-haiku-5-5
ANTHROPIC_MODEL_EXPLAIN=claude-haiku-5-5
LLM_TIMEOUT_SECONDS=20
LLM_CIRCUIT_BREAKER_SECONDS=60
LLM_EXPLAIN_TOP_N=3

# Cost guard (paid providers only; Gemini free tier costs $0)
LLM_DAILY_BUDGET_USD=5
GUEST_DAILY_AI_SEARCHES=10
USER_DAILY_AI_SEARCHES=40

# People ranking (plan §3.2)
PERSON_MIN_VOTES_MOVIE=1000
PERSON_MIN_VOTES_TV=300
PERSON_MIN_EPISODES=3
PERSON_LEAD_MAX_ORDER=4

# Cache
# Cache & counters live in the database (plan v1.8, no Redis): db | locmem
CACHE_BACKEND=db
CACHE_MAX_ENTRIES=5000
# Serverless: 0 = close DB connections after each request (Neon pooled URL in prod)
DB_CONN_MAX_AGE=0
SEARCH_CACHE_TTL_SECONDS=3600

# Monitoring
SENTRY_DSN=
