{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "config/wsgi.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,**/test_*.py,**/__pycache__/**,staticfiles/**,Dockerfile,requirements/dev.txt}"
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/daily/",
      "schedule": "0 5 * * *"
    }
  ]
}
